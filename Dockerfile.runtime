FROM node:22-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git python3 python3-pip python3-venv \
    golang-go cargo default-jdk \
    && rm -rf /var/lib/apt/lists/*
RUN npm install -g @anthropic-ai/claude-code @openai/codex
RUN useradd -m -u 1000 -s /bin/bash agent \
    && mkdir -p /home/agent/.codex \
    && python3 -m venv /home/agent/.venv \
    && chown -R agent:agent /home/agent

COPY docker/github-askpass /usr/local/bin/github-askpass
RUN chmod 755 /usr/local/bin/github-askpass

ENV HOME=/home/agent
ENV PATH=/home/agent/.venv/bin:$PATH
WORKDIR /workspace
USER agent
